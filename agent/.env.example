# In this directory: copy to .env and install deps with `uv sync` (see pyproject.toml).
#
# Gemini
GEMINI_API_KEY=...
# Optional, e.g. gemini-2.0-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-2.0-flash
# Print Gemini thinking summaries when the model returns them.
GEMINI_INCLUDE_THOUGHTS=true
# Gemini 2.5 only: -1 lets the model choose, 0 disables where supported.
GEMINI_THINKING_BUDGET=-1

# Read-only: example / schema context (repo `brian/` by default)
BRIAN_REFERENCE_DIR=

# Working brain: created lazily from the initial prompt and selected source files
BRAIN_DIR=
