# Agent LLM configuration.
# The agent reads from the root .env OR from this file (agent/.env).

# ── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
# Optional: gpt-4o, gpt-4o-mini, gpt-4.1, etc.
OPENAI_MODEL=gpt-4o-mini

# ── Brain paths (optional, defaults to repo root brian/ and brain/) ──────────
BRIAN_REFERENCE_DIR=
BRAIN_DIR=

# ── Slack integration ───────────────────────────────────────────────────────
# Slack signs every Events-API request with HMAC-SHA256 using this secret.
# Get it from your Slack app's "Basic Information" page. When unset, the
# /slack/events endpoint fails open so you can smoke-test without Slack.
SLACK_SIGNING_SECRET=
# Optional: only required if you want the bot to post replies via
# chat.postMessage. The current integration only ingests, so this can stay
# empty for the demo.
SLACK_BOT_TOKEN=
