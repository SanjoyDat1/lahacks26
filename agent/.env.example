# In this directory: copy to .env and install deps with `uv sync` (see pyproject.toml).
#
# OpenRouter (OpenAI-compatible)
OPENROUTER_API_KEY=sk-or-v1-...
# Optional, e.g. openai/gpt-4o-mini
OPENROUTER_MODEL=openai/gpt-4o-mini

# Read-only: example / schema context (repo `brian/` by default)
BRIAN_REFERENCE_DIR=

# Working brain: created on first run; populated from the reference if empty
BRAIN_DIR=
