# In this directory: copy to .env and install deps with `uv sync` (see pyproject.toml).
#
# Google Gemini
GOOGLE_API_KEY=your-google-api-key
# Alternate env name also accepted by the runtime: GEMINI_API_KEY=your-google-api-key
# Optional, e.g. gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Read-only: example / schema context (repo `brian/` by default)
BRIAN_REFERENCE_DIR=

# Working brain: created on first run; populated from the reference if empty
BRAIN_DIR=
