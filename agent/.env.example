# Agent LLM configuration.
# The agent reads from the root .env OR from this file (agent/.env).
# OpenAI takes priority over Gemini if both keys are set.

# ── OpenAI (primary) ─────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
# Optional: gpt-4o, gpt-4o-mini, gpt-4.1, etc.
OPENAI_MODEL=gpt-4o-mini

# ── Gemini (fallback) ────────────────────────────────────────────────────────
GEMINI_API_KEY=
# Optional: gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-2.5-flash
# Print Gemini thinking summaries when the model returns them.
GEMINI_INCLUDE_THOUGHTS=true
# Gemini 2.5 only: -1 lets the model choose, 0 disables where supported.
GEMINI_THINKING_BUDGET=-1

# ── Brain paths (optional, defaults to repo root brian/ and brain/) ──────────
BRIAN_REFERENCE_DIR=
BRAIN_DIR=
