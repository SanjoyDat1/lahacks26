# Agent LLM configuration.
# The agent reads from the root .env OR from this file (agent/.env).

# ── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
# Optional: gpt-4o, gpt-4o-mini, gpt-4.1, etc.
OPENAI_MODEL=gpt-4o-mini

# ── Brain paths (optional, defaults to repo root brian/ and brain/) ──────────
BRIAN_REFERENCE_DIR=
BRAIN_DIR=

# ── Slack compatibility (optional) ───────────────────────────────────────────
# Slack Event Subscriptions should normally use the Next.js app:
#   POST https://your-app/api/ingest/slack
# If Slack is pointed at brain-api:8000/slack/events instead, set this so the
# API proxies to Next (same machine: http://127.0.0.1:3000).
# FRONTEND_BASE_URL=http://127.0.0.1:3000
