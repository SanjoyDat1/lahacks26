# App — use `.env` here or at repo root (not `.env.local` for Google; see src/lib/load-env-dot-only.ts).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Brain agent (session builder + initialize). Run in another terminal: npm run brain-api (from frontend/)
# or: cd ../agent && uv run brain-api
AGENT_API_URL=http://localhost:8000
# Browser bootstrap WebSocket; use a URL your browser can reach (tunnels, LAN IP, etc.).
NEXT_PUBLIC_AGENT_API_URL=http://localhost:8000

# ── Google Workspace (session builder: Drive, Docs, Sheets, Calendar import) ──
# Create an OAuth 2.0 Client (Web) in Google Cloud Console.
# Authorized redirect URI: {NEXT_PUBLIC_APP_URL}/api/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Random string 16+ chars; encrypts OAuth tokens in httpOnly cookies
GOOGLE_COOKIE_SECRET=

# Optional override if callback path differs
# GOOGLE_REDIRECT_PATH=/api/integrations/google/callback

# Meeting / transcript webhooks (see /api/ingest/meetings)
# MEETINGS_WEBHOOK_SECRET=
