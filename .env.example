NEXT_PUBLIC_APP_URL=http://localhost:3000

# Next.js loads env from this repo root (see frontend/next.config.ts `envDir`).
# Brain agent for session bootstrap WebSocket (start API: cd agent && uv run brain-api
# — or from frontend/: npm run brain-api). Next.js uses AGENT_API_URL server-side; the
# browser uses NEXT_PUBLIC_AGENT_API_URL for the WebSocket when set.
AGENT_API_URL=http://localhost:8000
NEXT_PUBLIC_AGENT_API_URL=http://localhost:8000

# ── Google Workspace (OAuth in Next.js; see brian/integrations/google-workspace.md) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_COOKIE_SECRET=

# Production persistence. Use Neon, Supabase, or another Postgres provider with pgvector enabled.
DATABASE_URL=postgres://user:password@host:5432/ai_brain

# LLM provider. Without this, the app uses deterministic local fallbacks for demos.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Agent: optional cheaper model for extraction / cleanup. Unset → gpt-4o-mini in code.
# OPENAI_MINI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Git-backed brain repository. Without this, brain edits are stored in memory for local demos.
GITHUB_TOKEN=
BRAIN_REPO_OWNER=
BRAIN_REPO_NAME=
BRAIN_REPO_BRANCH=main

# Optional webhook verification secrets.
GITHUB_WEBHOOK_SECRET=
GITLAB_WEBHOOK_SECRET=
SLACK_SIGNING_SECRET=
DISCORD_WEBHOOK_SECRET=
MEETINGS_WEBHOOK_SECRET=
